hlossen werden. Bitte versuchen Sie es erneut.' : lang === 'en' ? 'Registration could not be completed. Please try again.' : 'L’inscription n’a pas abouti. Veuillez réessayer.';","__wwtype":"js","defaultValue":"<div>Account with that email already exists, please Log in</div>"}},"_ww-text_color":"hsl(0, 72%, 64%)","transformation":"","_ww-text_nowrap":false,"_ww-text_ellipsis":false,"_ww-text_textAlign":"center","_ww-text_textShadow":"","_ww-text_wordSpacing":"","_ww-text_letterSpacing":"0px","_ww-text_textTransform":"","_ww-text_textDecoration":"none","_ww-text_textDecorationStyle":"solid"}},"name":"Message","wwObjectBaseId":"d7904e9d-fc9a-4d80-9e32-728e097879ad","libraryComponentBaseId":null,"parentSectionId":"cfd8b572-2040-404f-b91f-a5dd79fdd2e1","_si":854},"0b498fc4-64f2-4dda-a8fb-457526cb1863":{"uid":"0b498fc4-64f2-4dda-a8fb-457526cb1863","_state":{"style":{"default":{"width":"100%"}}},"content":{"default":{"source":{"code":"const lang=globalContext.page?.lang || variables['b2741336-a288-4036-a753-7e767b0b81f2'] || 'fr';const l=['de','en'].includes(lang)?lang:'fr';const t={fr:{a:'I accept the',terms:'terms of use',and:'and the',privacy:'privacy policy'},de:{a:'Ich akzeptiere die',terms:'Nutzungsbedingungen',and:'und die',privacy:'Datenschutzerklärung'},en:{a:'J’accepte les',terms:'conditions d’utilisation',and:'et la',privacy:'politique de confidentialité'}}[l];const prefix=l==='fr'?'':l==='en'?'/fr':'/'+l;return '<label style=\"display:flex;gap:10px;align-items:flex-start;font:inherit;font-size:13px;line-height:1.6;margin:12px 0;color:inherit\"><input id=\"hr-terms-accepted\" name=\"conditions_acceptees\" type=\"checkbox\" required style=\"flex-shrink:0;margin-top:4px;accent-color:#7545cc\"><span>'+t.a+' <a href=\"'+prefix+'/utilisation\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#7545cc;text-decoration:underline\">'+t.terms+'</a> '+t.and+' <a href=\"'+prefix+'/confidentialite\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#7545cc;text-decoration:underline\">'+t.privacy+'</a>.</span></label>';","__wwtype":"js","defaultValue":""},"refreshOnResize":false}},"name":"Acceptation des conditions","wwObjectBaseId":"6d692ca2-6cdc-4805-aa0c-211102f335d0","libraryComponentBaseId":null,"parentSectionId":"cfd8b572-2040-404f-b91f-a5dd79fdd2e1","_si":866},"084873fd-0589-4fc4-b5e4-237e35aae2c1":{"uid":"084873fd-0589-4fc4-b5e4-237e35aae2c1","_state":{"style":{"default":{"align":"flex-start","width":"100%","cursor":"pointer","margin":"16px 0 16px 0","padding":"8px 16px","borderRadius":"8px","backgroundColor":"var(--bd6a542c-8470-4a5d-b59f-0c45d3e4a36c,#6B46C1)"}}},"content":{"default":{"disabled":false,"fontStyle":"ww-font-style-text","buttonType":"submit","globalStyle":{},"hasLeftIcon":false,"hasRightIcon":false,"_ww-text_text":{"de":"<div>Registrieren</div>","en":"<div>S’inscrire</div><div><br></div>","fr":"<div>Sign up</div>"},"_ww-text_color":"#FFFFFF","_ww-text_nowrap":false,"backgroundColor":"","_ww-text_ellipsis":false,"_ww-text_fontSize":"16px","_ww-text_textAlign":"","_ww-text_fontFamily":"","_ww-text_fontWeight":"","_ww-text_lineHeight":"","_ww-text_textShadow":"","_ww-text_wordSpacing":"","_ww-text_letterSpacing":"0px","_ww-text_textTransform":"","_ww-text_textDecoration":"none","_ww-text_textDecorationStyle":"solid"}},"name":"Signin Btn","wwObjectBaseId":"6f8796b1-8273-498d-95fc-7013b7c63214","libraryComponentBaseId":null,"parentSectionId":"cfd8b572-2040-404f-b91f-a5dd79fdd2e1","_si":867},"0c80e2d8-b74e-4e50-af71-e2669c95e829":{"uid":"0c80e2d8-b74e-4e50-af71-e2669c95e829","_state":{"id":"inscription-hrvalais","style":{"default":{"width":"100%"}},"interactions":[{"id":"eb923085-c57a-44e9-81f4-4b4ecafaea4a","icon":"16/lightning-bolt","name":"Inscription HR Valais — créer le compte et envoyer le lien mot de passe","type":"front","index":0,"actions":{"238e2e35-3509-4cb2-bb1e-34a8f4c581a0":{"id":"238e2e35-3509-4cb2-bb1e-34a8f4c581a0","name":"Afficher l’erreur d’inscription","type":"variable","varId":"7a7628fb-b9de-4baf-b90f-a24f209e41ff","internal":false,"varValue":"registration_failed"},"b0f70b77-62ca-4d87-8bc8-d422d2316ee7":{"id":"b0f70b77-62ca-4d87-8bc8-d422d2316ee7","code":"const section = wwLib.getFrontWindow().document.getElementById('inscription-hrvalais');\nconst read = (name) => String(section?.querySelector(`input[name=\"${name}\"]`)?.value || '').trim();\nconst prenom = read('prenom');\nconst nom = read('nom');\nconst email = read('email').toLowerCase();\nconst conditions_acceptees = Boolean(section?.querySelector('#hr-terms-accepted')?.checked);\nif (!prenom || !nom || !email || !conditions_acceptees) {\n  window.alert('Vérifiez les champs obligatoires et acceptez les conditions.');\n} else {\n  try {\n    const response = await fetch('https://msrsidkrdyzdeatvlgya.supabase.co/functions/v1/signup-hrvalais', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1zcnNpZGtyZHl6ZGVhdHZsZ3lhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzUyOTUwOTQsImV4cCI6MjA5MDg3MTA5NH0.KHYhcSMBtdF0YZxk5hlGUsO2qNtRH7T6QLezVaGMGM4',\n        'Authorization': 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1zcnNpZGtyZHl6ZGVhdHZsZ3lhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzUyOTUwOTQsImV4cCI6MjA5MDg3MTA5NH0.KHYhcSMBtdF0YZxk5hlGUsO2qNtRH7T6QLezVaGMGM4'\n      },\n      body: JSON.stringify({ prenom, nom, email, langue: 'fr', conditions_acceptees })\n    });\n    const result = await response.json().catch(() => ({}));\n    if (!response.ok) throw new Error(result.error || 'Inscription impossible. Réessayez plus tard.');\n    window.alert(result.message || 'Consultez votre e-mail pour choisir votre mot de passe.');\n  } catch (error) {\n    window.alert(error?.message || 'Inscription impossible. Réessayez plus tard.');\n  }\n}","name":"Créer le compte et envoyer le lien de mot de passe","type":"custom-js"}},"trigger":"submit","version":2,"isSearched":false,"description":"On submit","firstAction":"b0f70b77-62ca-4d87-8bc8-d422d2316ee7","firstErrorAction":"238e2e35-3509-4cb2-bb1e-34a8f4c581a0"}]},"content":{"default":{"validation":"submit","formContent":[{"uid":"a3096078-b7e7-41fc-97ff-4547ba66e999","isWwObject":true},{"uid":"2df44fec-4a79-48a0-989c-9b4dbb7aa99d","isWwObject":true},{"uid":"ae5c212d-a625-4880-9019-9dfbf2b17225","isWwObject":true},{"uid":"0b498fc4-64f2-4dda-a8fb-457526cb1863","isWwObject":true},{"uid":"084873fd-0589-4fc4-b5e4-237e35aae2c1","isWwObject":true},{"uid":"dbc152ed-ab06-48de-a72d-f3fac2465e7d","isWwObject":true}],"autocomplete":true,"debounceDelay":"500ms"}},"name":"Form container","wwObjectBaseId":"9ecb2cfc-cef7-4be8-b736-3e17a3b7e9ff","libraryComponentBaseId":null,"parentSectionId":"cfd8b572-2040-404f-b91f-a5dd79fdd2e1","_si":919},"efe85c2d-1f5b-43d5-ad15-6624dbb2b75f":{"uid":"efe85c2d-1f5b-43d5-ad15-6624dbb2b75f","_state":{"style":{"default":{"margin":"0 0 36px 0"}}},"content":{"tablet":{},"default":{"tag":"p","bgColor":"","shadows":"","fontStyle":"ww-font-style-text","textColor":"","globalStyle":{},"_ww-text_font":"var(--575560c1-5459-4f1e-ae9a-4ddfaa1e8358, 400 14px/20px var(--ww-default-font-family, sans-serif))","_ww-text_text":{"de":"<div>Erstellen Sie Ihr Konto und testen Sie IA Express 7 Tage lang mit 5 CHF KI-Guthaben. Der Zugang endet, sobald eine der beiden Grenzen erreicht ist.</div>","en":"<div>Créez votre compte pour essayer IA Express pendant 7 jours avec CHF 5 de crédit de consommation IA. L’accès s’arrête dès qu’une des deux limites est atteinte. Vous recevrez un e-mail pour choisir votre mot de passe.</div>","fr":"<div>Create your account to try IA Express for 7 days with CHF 5 in AI usage credit. Access ends when either limit is reached.</div><div><br></div>"},"_ww-text_color":"var(--1a1fc27c-c1e7-40bf-a107-8608ee41f1c8,#3F3F46)","transformation":"","_ww-text_nowrap":false,"backgroundColor":"","_ww-text_ellipsis":false,"_ww-text_textAlign":"","_ww-text_textShadow"